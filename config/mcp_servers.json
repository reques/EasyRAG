{
  "servers": [
    {
      "name": "demo",
      "transport": "stdio",
      "enabled": true,
      "command": ["python", "-m", "app.tools.mcp.demo_server"],
      "capabilities": ["none"],
      "allowed_tools": ["*"]
    },
    {
      "name": "filesystem",
      "transport": "stdio",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./volumes"],
      "capabilities": ["fs.read", "proc.exec"],
      "allowed_tools": [
        "read_file",
        "read_directory",
        "list_directory",
        "get_file_info",
        "search_files",
        "directory_tree"
      ]
    }
  ]
}
