# =============================================================================
# EasyRAG 配置文件模板
# 复制此文件为 .env 并填入真实值
# =============================================================================

# ── 应用基础 ──────────────────────────────────────────────────────────────
APP_NAME=EasyRAG Agent
APP_VERSION=0.2.0
DEBUG=false
LOG_LEVEL=INFO

# ── 服务器 ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ── LLM (兼容 OpenAI API) ─────────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── Embedding ─────────────────────────────────────────────────────────────
# local = SentenceTransformers (BGE-M3), openai_compatible = HTTP API
EMBEDDING_TYPE=local
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DIMENSION=1024

# ── 向量库 (memory / milvus / chroma) ────────────────────────────────────
VECTOR_STORE_TYPE=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_docs
MILVUS_DATA_DIR=./milvus_data
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_docs

# ── RAG 参数 ──────────────────────────────────────────────────────────────
RETRIEVER_TOP_K=4
RAG_SCORE_THRESHOLD=0.0
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Agent / LangGraph ─────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=20
MAX_PLAN_STEPS=5
SESSION_TTL=3600

# ── 答案验证 ──────────────────────────────────────────────────────────────
ANSWER_VALIDATION_ENABLED=true
ANSWER_MIN_LENGTH=20

# ===========================================================================
# 阶段 1 新增配置
# ===========================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=easyrag
POSTGRES_PASSWORD=easyrag_secret
POSTGRES_DB=easyrag
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
DATABASE_URL=postgresql+asyncpg://easyrag:easyrag_secret@localhost:5432/easyrag

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── MinIO (应用文件存储，非 Milvus 的 minio) ──────────────────────────────
MINIO_ENDPOINT=localhost:9091
MINIO_ACCESS_KEY=easyrag_admin
MINIO_SECRET_KEY=easyrag_minio_secret
MINIO_BUCKET=easyrag-files
MINIO_SECURE=false

# ── JWT 认证 ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
