# =============================================================================
# EasyRAG 配置文件模板
# 复制此文件为 .env 并填入真实值
# =============================================================================

# ── 应用基础 ──────────────────────────────────────────────────────────────
APP_NAME=EasyRAG Agent
APP_VERSION=0.3.1
DEBUG=false
LOG_LEVEL=INFO

# ── 服务器 ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ── LLM (兼容 OpenAI API) ─────────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── 对话页可切换模型（仅后端读取密钥）─────────────────────────────────────
# 如果多个模型使用同一网关：把各 BASE_URL 都设为 LLM_BASE_URL；对应专用密钥留空时，
# 后端会安全复用 DEEPSEEK_API_KEY。直连官方接口时，请分别填写供应商 API Key。
LLM_DEFAULT_MODEL_ID=deepseek-v4-flash

MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TEMPERATURE=0.1

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.0

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.6-flash
QWEN_TEMPERATURE=0.0

GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_API_KEY=
GLM_MODEL=glm-5.2
GLM_TEMPERATURE=0.6

# ── Embedding ─────────────────────────────────────────────────────────────
# local = SentenceTransformers (BGE-M3), openai_compatible = HTTP API, ollama = 本地 Ollama
EMBEDDING_TYPE=local
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DIMENSION=1024

# ── Ollama 本地嵌入（EMBEDDING_TYPE=ollama 时生效）─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_TIMEOUT=60

# ── 向量库 (memory / milvus / chroma) ────────────────────────────────────
VECTOR_STORE_TYPE=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_docs
MILVUS_DATA_DIR=./milvus_data
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_docs

# ── RAG 参数 ─────────────────────────────────────────────────────────────
RETRIEVER_TOP_K=4
# 分块策略：recursive（默认）/ fixed / markdown / parent_child / legal
# legal = 法律条文按「第X条」切分；解析入库的文档会自动检测法律条文并按 legal 切分。
# CHUNK_STRATEGY=legal
RAG_SCORE_THRESHOLD=0.0
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── 可选 Ragas 评估（检索质量指标）─────────────────────────────────────────────────────────────────
# 默认关闭；RAGAS_PYTHON_EXECUTABLE 留空时后端自动探测项目内
# .venv-ragas / venv-ragas / ragas-env 虚拟环境，也可显式指定绝对路径。
RAGAS_ENABLED=false
RAGAS_EXECUTION_MODE=process
RAGAS_PYTHON_EXECUTABLE=
# 指标集（逗号分隔）：
#   id_context_precision/id_context_recall   无 LLM 集合匹配，适合日常回归
#   context_precision/context_recall         LLM 语义 + 排序敏感，需配 RAGAS_LLM_*
#   faithfulness/answer_relevancy            生成质量（端到端评测预留）
RAGAS_METRICS=id_context_precision,id_context_recall
RAGAS_TIMEOUT=300
# 仅 context_precision/context_recall 等 LLM 指标需要；留空回退主 LLM 配置。
RAGAS_LLM_BASE_URL=
RAGAS_LLM_API_KEY=
RAGAS_LLM_MODEL=

# MinerU document parser
# Host-run EasyRAG: http://127.0.0.1:18000
# Docker-run EasyRAG: http://host.docker.internal:18000
MINERU_ENABLED=false
MINERU_API_URL=http://127.0.0.1:18000
MINERU_BACKEND=pipeline
MINERU_LANG=ch
MINERU_CONNECT_TIMEOUT=10
MINERU_REQUEST_TIMEOUT=60
MINERU_RESULT_DOWNLOAD_TIMEOUT=600
MINERU_TASK_TIMEOUT=3600
MINERU_POLL_INTERVAL=2
MINERU_FALLBACK_TO_LOCAL=true

# 执行路径：
#   auto       智能路由（默认）：普通问题走轻量动态 Agent（模型自行决定调工具/检索/直答），
#               跨领域/复杂查询（命中 ≥ 2 个领域关键词 或 长查询+连词）走 DeepAgents
#   dynamic    轻量动态 Agent：每轮由模型自行决定直接回答 / 调工具 / 检索知识库，
#               简单问题只需一次 LLM 调用，不走复杂流程
#   single     仅单 Agent（旧固定管线：query_rewrite -> intent -> retrieval/tool -> validate）
#   multi      deepagents 的兼容别名（已废弃，配置请改用 deepagents）
#   deepagents DeepAgents：主 Agent（create_react_agent）+ task/spawn_tasks 委派 SubAgent
# AGENT_MODE=auto


# ── DeepAgents（AGENT_MODE=deepagents 时生效）────────────────────────────
# 外部 SubAgent 配置文件（JSON/YAML；为空使用内置 research-agent/coding-agent）：
#   {"subagents": [{"name": "...", "description": "...", "system_prompt": "...",
#                   "tools": ["web_search", "kb_search", ...]}]}
# 文件不存在/格式错误会自动回退内置并告警，不会导致启动失败。
# DEEP_SUBAGENTS_FILE=
# 主 Agent 与 task 委派 SubAgent 的 LangGraph recursion_limit
# DEEP_MAIN_RECURSION_LIMIT=20
# DEEP_SUBAGENT_RECURSION_LIMIT=20

# ── 答案验证 ──────────────────────────────────────────────────────────────
ANSWER_VALIDATION_ENABLED=true
ANSWER_MIN_LENGTH=20

# ── 快速路径（简单问题零成本分流）────────────────────────────────────────
# 简单常识/问候/计算/时间问题先用规则预判直接回答，跳过 LLM 意图分类、
# 检索与工具调用（避免"吃坏肚子怎么办"这类问题被误判成联网搜索）。
# 关闭后回退到旧的纯 LLM 意图分类行为。
FAST_INTENT_ENABLED=true

# ── 上下文管理 ─────────────────────────────────────────────────────────────
# 会话摘要长期生成失败（LLM 不可用）时，注入 LLM 的原始消息上限：
# 超出部分取真实尾部并记日志，避免长会话撑爆上下文窗口。
# 正常路径（有摘要）不受此限制：摘要承载远期上下文 + 最近 20 条。
HISTORY_CONTEXT_MAX_MESSAGES=100

# ===========================================================================
# 阶段 1 新增配置
# ===========================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=easyrag
POSTGRES_PASSWORD=easyrag_secret
POSTGRES_DB=easyrag
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
DATABASE_URL=postgresql+asyncpg://easyrag:easyrag_secret@localhost:5432/easyrag

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── MinIO (应用文件存储，非 Milvus 的 minio) ──────────────────────────────
MINIO_ENDPOINT=localhost:9091
MINIO_ACCESS_KEY=easyrag_admin
MINIO_SECRET_KEY=easyrag_minio_secret
MINIO_BUCKET=easyrag-files
MINIO_SECURE=false

# ── JWT 认证 ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MODEL_CONFIG_ENCRYPTION_KEY=

# ── Tavily 联网搜索 ──────────────────────────────────────────────────────────
# 到 https://app.tavily.com 注册获取 API Key
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_ANSWER=true


GRAPH_ENABLED=true
ENHANCED_RETRIEVAL_ENABLED=true
# 查询分解缓存 TTL（秒）：同一问题在窗口内返回完全相同的子问题划分
ENHANCED_DECOMPOSITION_CACHE_TTL=3600
# 增强检索 Top-K：每子问题/每路检索取 top_k_per_path 条（相似度需 >= RAG_SCORE_THRESHOLD）
ENHANCED_TOP_K_PER_PATH=6
ENHANCED_FINAL_TOP_K=8

# ── Neo4j GraphRAG 图谱（docker compose 已含 neo4j 服务）──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=easyrag_neo4j_secret
# 图谱构建：默认 8 路并发；若上游返回 429，请降为 4。
GRAPH_EXTRACT_CONCURRENCY=8
# 每次 LLM 请求最多合并 4 个 chunk / 1800 字；结果仍按原 chunk 分开保存和溯源。
GRAPH_EXTRACT_PACK_MAX_CHUNKS=4
GRAPH_EXTRACT_PACK_MAX_CHARS=1800
# 仅限制图谱 JSON 输出，不影响聊天回复长度。
GRAPH_EXTRACT_MAX_TOKENS=1024
# 图谱抽取关闭思考模式：结构化 JSON 抽取无需推理链，省约费用；网关不支持会自动降级。
GRAPH_EXTRACT_REASONING_EFFORT=none
# 重复构建时复用内容、模型和 prompt 均未变化的抽取结果。
GRAPH_EXTRACT_CACHE_ENABLED=true
# 与 Ollama /api/embed 的安全批次保持一致。
GRAPH_BUILD_BATCH_SIZE=32
